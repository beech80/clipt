# Local development only. Never put a service-role key in a VITE variable.
VITE_APP_ENV=development
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=sb_publishable_local_test_fixture
VITE_BILLING_CHECKOUT_DISABLED=true
VITE_BILLING_READINESS_ENABLED=false
# Enable only against an environment where the invitation RPC is installed.
VITE_BETA_ACCESS_REQUIRED=false
